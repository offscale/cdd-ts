{
  "name": "cdd-ts",
  "version": "0.0.4",
  "description": "OpenAPI ↔ TypeScript",
  "keywords": [
    "openapi",
    "cdd",
    "angular",
    "codegen",
    "parser",
    "emitter",
    "compiler"
  ],
  "homepage": "https://github.com/offscale/cdd-ts#readme",
  "bugs": {
    "url": "https://github.com/offscale/cdd-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offscale/cdd-ts.git"
  },
  "license": "MIT",
  "author": "Samuel Marks <807580+SamuelMarks@users.noreply.github.com>",
  "type": "module",
  "bin": {
    "cdd-ts": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "check:types": "tsc --noEmit && type-coverage --project ./tsconfig.json --detail --at-least 100",
    "clean": "rm -rf dist docs coverage .vitest-cache node_modules/.vite",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "docs": "typedoc",
    "lint": "biome lint .",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js",
    "test": "vitest run --run",
    "test:coverage": "vitest run --run --coverage",
    "prepare": "husky",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32",
    "@ts-morph/common": "file:../ts-morph/packages/common",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "as-wasi": "^0.6",
    "code-block-writer": "^13.0",
    "commander": "^15.0",
    "js-yaml": "^5.5",
    "path-browserify": "^1.0",
    "ts-morph": "file:../ts-morph/packages/ts-morph",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@angular/common": "^22.2",
    "@angular/compiler": "^22.2",
    "@biomejs/biome": "^2.6",
    "@faker-js/faker": "^10.6",
    "@swc/cli": "^0.8",
    "@swc/core": "^1.16",
    "@swc/helpers": "^0.5",
    "@types/js-yaml": "^4.0",
    "@types/node": "^26.6",
    "@types/swagger-schema-official": "^2.0",
    "@vitest/coverage-istanbul": "^5.0",
    "@vitest/coverage-v8": "^5.0",
    "esbuild": "^0.28",
    "glob": "^14.0",
    "husky": "^9.1",
    "pg": "^8.23",
    "rolldown": "^1.2",
    "sqlite3": "^6.0",
    "swagger-schema-official": "^2.0.0-bab6bed",
    "swc-node": "^1.0",
    "tsc-alias": "^1.9",
    "tsx": "^4.23",
    "type-coverage": "^2.30",
    "typedoc": "^0.28",
    "typeorm": "^1.1",
    "vitest": "^5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sqlite3@6.0.1": true,
    "@swc/core@1.16.20": true,
    "fsevents@2.3.3": true
  }
}
