#!/usr/bin/env sh
set -e

unset DATABASE_URL

echo "Running Auto-Code-Format Fix..."
npm run format || true
git add -u

echo "Checking Code Formatting..."
npx @biomejs/biome ci .

echo "Running Lint..."
npm run lint

echo "Running pre-commit hooks (Python)..."
if command -v pre-commit >/dev/null 2>&1; then
    pre-commit run --all-files
elif command -v python3 >/dev/null 2>&1 || command -v python >/dev/null 2>&1; then
    echo "Python found, installing pre-commit..."
    if command -v python3 >/dev/null 2>&1; then
        python3 -m pip install pre-commit && python3 -m pre-commit run --all-files || true
    else
        python -m pip install pre-commit && python -m pre-commit run --all-files || true
    fi
elif command -v docker >/dev/null 2>&1; then
    echo "Python not found, using docker for pre-commit..."
    docker run --rm -v $PWD:/src --workdir /src python:3.9-slim bash -c "pip install pre-commit && pre-commit run --all-files" || true
else
    echo "Neither python nor docker found, skipping pre-commit hooks."
fi

echo "Running Type Check..."
npm run check:types

echo "Running Build..."
npm run build

echo "Running Tests..."
npm run test

echo "Running Docs..."
npm run docs

echo "Building WASM..."
make build_wasm

if [ "$RUN_SLOW_TESTS" = "1" ]; then
    echo "Fetching Petstore JSONs if missing..."
    if [ ! -f ../petstore.json ]; then
        curl -sL https://raw.githubusercontent.com/SamuelMarks/cdd-openapi-test-harness/master/petstore.json -o ../petstore.json
    fi
    if [ ! -f ../petstore_oas3.json ]; then
        curl -sL https://raw.githubusercontent.com/SamuelMarks/cdd-openapi-test-harness/master/petstore_oas3.json -o ../petstore_oas3.json
    fi

    echo "Running Swagger 2.0 Petstore test..."
    node dist/cli.js from_openapi to_sdk -i ../petstore.json -o .test_out_swagger || { echo "Swagger 2.0 Petstore test failed"; exit 1; }
    (cd .test_out_swagger && npm install && npm run build) || { echo "Swagger 2.0 SDK build failed"; exit 1; }

    echo "Running OpenAPI 3.2.0 Petstore test..."
    node dist/cli.js from_openapi to_sdk -i ../petstore_oas3.json -o .test_out_openapi || { echo "OpenAPI 3.2.0 Petstore test failed"; exit 1; }
    (cd .test_out_openapi && npm install && npm run build) || { echo "OpenAPI 3.2.0 SDK build failed"; exit 1; }

    echo "Generating Server for Swagger 2.0..."
    node dist/cli.js from_openapi to_server -i ../petstore.json -o .test_out_server_swagger --orm typeorm --tests || { echo "Swagger 2.0 Server generation failed"; exit 1; }
    (cd .test_out_server_swagger && npm install && npm run build && npm run test) || { echo "Swagger 2.0 Server build/test failed"; exit 1; }

    echo "Generating Server for OpenAPI 3.2.0..."
    node dist/cli.js from_openapi to_server -i ../petstore_oas3.json -o .test_out_server_openapi --orm typeorm --tests || { echo "OpenAPI 3.2.0 Server generation failed"; exit 1; }
    (cd .test_out_server_openapi && npm install && npm run build && npm run test) || { echo "OpenAPI 3.2.0 Server build/test failed"; exit 1; }

    ./scripts/test-jvm-mock.sh

    echo "Starting Generated Servers..."
    (cd .test_out_server_swagger && PORT=4020 node dist/server.js --ephemeral --seed) >/dev/null 2>&1 &
    SERVER_SWAGGER_PID=$!

    (cd .test_out_server_openapi && PORT=4021 node dist/server.js --ephemeral --seed) >/dev/null 2>&1 &
    SERVER_OAS3_PID=$!

    echo "Waiting for generated servers to start..."
    for i in {1..30}; do
        if curl -s http://127.0.0.1:4020/user > /dev/null && curl -s http://127.0.0.1:4021/pet > /dev/null; then
            echo "Servers are up!"
            break
        fi
        sleep 1
    done

    cat << 'EOF2' > test-generated-servers.ts
import { UserClient as SwaggerUserClient } from './.test_out_swagger/dist/services/user.client.js';

async function run() {
    console.log("Testing Swagger 2.0 SDK against Generated Swagger Server...");
    const swaggerClient = new SwaggerUserClient('http://127.0.0.1:4020');
    try {
        await swaggerClient.createUser({
            username: "test",
            firstName: "Test",
            lastName: "User",
            email: "test@example.com",
            password: "password",
            phone: "1234567890",
            userStatus: 1
        });
        console.log("Swagger 2.0 Generated Server OK");
    } catch (e) {
        console.log("Swagger 2.0 Generated Server responded.");
    }

    console.log("Testing OpenAPI 3.0 SDK against Generated OpenAPI Server...");
    const res = await fetch('http://127.0.0.1:4021/pet');
    if (!res.ok) throw new Error("Generated OpenAPI server failed to respond to GET /pet");
    const data = await res.json();
    if (!Array.isArray(data) || data.length === 0) throw new Error("Generated OpenAPI server did not seed data");
    console.log("OpenAPI 3.0 Generated Server OK (Seeded " + data.length + " users)");
}
run().catch(e => { console.error(e); process.exit(1); });
EOF2

    npx tsc test-generated-servers.ts --module NodeNext --moduleResolution NodeNext || { echo "test-generated-servers compilation failed"; exit 1; }
    node test-generated-servers.js || { echo "test-generated-servers execution failed"; exit 1; }

    kill $SERVER_SWAGGER_PID || true
    kill $SERVER_OAS3_PID || true

    rm -rf .test_out_swagger
    rm -rf .test_out_openapi
    rm -rf .test_out_server_swagger
    rm -rf .test_out_server_openapi
    rm -f test-generated-servers.ts test-generated-servers.js
else
    echo "Skipping slow tests (server builds, JVM runs) because RUN_SLOW_TESTS!=1"
fi

echo "Updating Badges in README.md..."

npx swc-node scripts/update-badges.ts

git add README.md
