#!/usr/bin/env sh
set -e

echo "Running Auto-Code-Format Fix..."
npm run format || true
npx prettier --write 'src/**/*.ts' 'tests/**/*.ts' || true
git add src/ tests/

echo "Checking Code Formatting..."
npx prettier --check 'src/**/*.ts' 'tests/**/*.ts'

echo "Running Lint..."
npm run lint

echo "Running Type Check..."
npm run check:types

echo "Running Build..."
npm run build

echo "Running Tests with Coverage..."
npm run test:coverage

echo "Running Docs..."
npm run docs

echo "Building WASM..."
make build_wasm

echo "Building cdd-ts utilizing the local ts-morph wasm fork..."
make build_with_ts_go

echo "Building cdd-ts utilizing the new AOT Go+AS architecture..."
make build_with_ts_go_assemblyscript

echo "Updating Badges in README.md..."
npx esbuild scripts/update-badges.ts --bundle --platform=node --outfile=scripts/update-badges.js
node scripts/update-badges.js
rm scripts/update-badges.js
git add README.md
