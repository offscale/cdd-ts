#!/usr/bin/env sh
set -e

echo "Running Auto-Code-Format Fix..."
npm run format || true
npx prettier --write 'src/**/*.ts' 'tests/**/*.ts' || true
git add src/ tests/

echo "Checking Code Formatting..."
npx prettier --check 'src/**/*.ts' 'tests/**/*.ts'

echo "Running Lint..."
npm run lint

echo "Running Type Check..."
npm run check:types

echo "Running Build..."
npm run build

echo "Running Tests with Coverage..."
npm run test:coverage

echo "Running Docs..."
npm run docs

echo "Building WASM..."
make build_wasm

echo "Running Swagger 2.0 Petstore test..."
node dist/cli.js from_openapi to_sdk -i ../petstore.json -o .test_out_swagger || { echo "Swagger 2.0 Petstore test failed"; exit 1; }
rm -rf .test_out_swagger

echo "Running OpenAPI 3.2.0 Petstore test..."
node dist/cli.js from_openapi to_sdk -i ../petstore_oas3.json -o .test_out_openapi || { echo "OpenAPI 3.2.0 Petstore test failed"; exit 1; }
rm -rf .test_out_openapi

echo "Building cdd-ts utilizing the local ts-morph wasm fork..."
make build_with_ts_go

echo "Building cdd-ts utilizing the new AOT Go+AS architecture..."
make build_with_ts_go_assemblyscript

echo "Updating Badges in README.md..."
npx esbuild scripts/update-badges.ts --bundle --platform=node --outfile=scripts/update-badges.cjs
node scripts/update-badges.cjs
rm scripts/update-badges.cjs
git add README.md
